[Unit]
Description=smlgw - smart meter to MQTT gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/paths to your install. This matches a git clone in the user's
# home (e.g. /home/alarm/smlgw) with a virtualenv in .venv there.
User=alarm
Group=alarm
WorkingDirectory=/home/alarm/smlgw
ExecStart=/home/alarm/smlgw/.venv/bin/smlgw run --config /home/alarm/smlgw/config.yaml --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Serial access: add the group that owns your meter's device. Check with
#   ls -l /dev/ttyUSB0
# On Arch Linux ARM this is usually "uucp"; on Debian/Raspberry Pi OS "dialout".
# Uncomment and set it once you have a meter connected:
#SupplementaryGroups=uucp

[Install]
WantedBy=multi-user.target
